{
  "name": "thaarei-starter-source",
  "version": "1.0.0-dev.1",
  "private": true,
  "description": "Source template and validation tooling for independent Thaarei client repositories.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.20.x"
  },
  "scripts": {
    "check:boundaries": "tsx packages/tooling/src/governance/cli.ts check:boundaries",
    "check:implementation": "tsx packages/tooling/src/governance/cli.ts check:implementation",
    "check:publication": "tsx packages/tooling/src/publication.ts",
    "check:source-of-truth": "tsx packages/tooling/src/governance/cli.ts check:source-of-truth",
    "check:fixtures": "tsx packages/create-app/src/validate-fixtures.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "implementation:list": "tsx packages/tooling/src/governance/cli.ts implementation:list",
    "implementation:new": "tsx packages/tooling/src/governance/cli.ts implementation:new",
    "implementation:sync": "tsx packages/tooling/src/governance/cli.ts implementation:sync",
    "lint": "biome lint .",
    "release:check": "tsx packages/tooling/src/release/check-release.ts",
    "starter:init": "tsx packages/create-app/src/index.ts",
    "packages:build": "pnpm --filter @thaarei-technology/foundation build && pnpm --filter @thaarei-technology/tooling build && pnpm --filter @thaarei-technology/create-app build",
    "packages:pack-check": "tsx packages/tooling/src/pack-check.ts",
    "validate:starter": "pnpm release:check && pnpm check:publication && pnpm check:source-of-truth && pnpm check:boundaries && pnpm check:implementation && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm packages:pack-check && pnpm check:fixtures",
    "validate:web-handoff": "tsx packages/create-app/src/validate-web-handoff.ts",
    "check": "pnpm validate:starter",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.13.3",
    "turbo": "2.10.10",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
